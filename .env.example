# OpenRouter API key used by the server-side policy analyzer.
# Create one at https://openrouter.ai/keys and add it to your Render service environment.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# PDF processing engine used by OpenRouter for uploaded policy PDFs.
# mistral-ocr is recommended for scanned/image-only insurance PDFs.
# cloudflare-ai is a lower-cost alternative for text-oriented PDFs.
OPENROUTER_PDF_ENGINE="mistral-ocr"

# Optional site URL sent to OpenRouter for request attribution.
APP_URL="MY_APP_URL"
