# Server-side OpenRouter API key used for policy PDF analysis.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# Free-model router. Change only if you intentionally choose another OpenRouter model.
OPENROUTER_MODEL="openrouter/free"

# mistral-ocr supports scanned/image-only PDFs. Note: OCR processing may have a separate charge.
OPENROUTER_PDF_ENGINE="mistral-ocr"
OPENROUTER_MAX_TOKENS="12000"

# Bulk-upload reliability controls.
OPENROUTER_MIN_INTERVAL_MS="3200"
OPENROUTER_MAX_RETRIES="2"
OPENROUTER_TIMEOUT_MS="180000"
MAX_BODY_SIZE="100mb"

# Optional site URL sent to OpenRouter for request attribution.
APP_URL="MY_APP_URL"
